{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comments on projects",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "likes": { "type": "number" }
      },
      "required": ["projectId", "userName", "content"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Client messages submitted via contact form",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "service": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "service", "message"]
    },
    "ProjectLike": {
      "title": "ProjectLike",
      "description": "Likes on studio projects",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account and profile data"
    },
    "/projects/{projectId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Real-time viewer comments on a project"
    },
    "/contacts/{contactId}": {
      "schema": "ContactMessage",
      "description": "Contact inquiries from potential studio clients"
    },
    "/projects/{projectId}/likes/{likeId}": {
      "schema": "ProjectLike",
      "description": "Project likes tracking"
    }
  }
}
